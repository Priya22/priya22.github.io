---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import Link from "@/components/Link.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	note: CollectionEntry<"note">;
};

const { as: Tag = "div", note } = Astro.props;
const authors = note.data.authors ?? [];
---

<div class="flex flex-col items-start">
	<Tag class="title !mb-0 text-base leading-tight">
		<a class="cactus-link" href={`/notes/${note.id}/`}>
			{note.data.title}
		</a>
	</Tag>
	{authors.length > 0 && <p class="text-sm">{authors.join(", ")}</p>}
	{note.data.venue && (
		<p class="text-sm italic">
			{note.data.venue},{" "}
			<FormattedDate dateTimeOptions={{ year: "numeric" }} date={note.data.publishDate} />
		</p>
	)}
	{note.data.description && <p class="mt-3 leading-relaxed">{note.data.description}</p>}
	{(note.data.paper || note.data.code) && (
		<p class="mt-1 flex flex-wrap gap-x-4 text-sm">
			{note.data.paper && <Link href={note.data.paper} , text="PDF" />}
			{note.data.code && <Link href={note.data.code} , text="Code" />}
		</p>
	)}
</div>
