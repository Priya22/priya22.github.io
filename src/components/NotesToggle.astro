---
interface Props {
	active: "all" | "featured";
}
const { active } = Astro.props;

const tabClass =
	"opacity-60 aria-[current=page]:font-bold aria-[current=page]:underline aria-[current=page]:opacity-100";
---

<nav class="mb-12 flex gap-4" aria-label="Filter notes">
	<a href="/notes/" class={tabClass} aria-current={active === "featured" ? "page" : undefined}>
		Featured
	</a>
	<a href="/notes/all" class={tabClass} aria-current={active === "all" ? "page" : undefined}>
		All
	</a>
</nav>
